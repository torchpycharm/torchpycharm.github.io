---
import SectionHeading from '../components/SectionHeading.astro';
import { publicFileExists } from '../utils/public-file';

type InterestItem = {
	title: string;
	subtitle?: string;
	badge?: string;
	href?: string;
	cover?: string;
};

type InterestCard = {
	label: string;
	title: string;
	icon: string;
	note?: string;
	items: readonly InterestItem[];
};

interface Props {
	kicker?: string;
	title: string;
	description?: string;
	cards: readonly InterestCard[];
}

const { cards, description, kicker, title } = Astro.props;
const rowClass = 'flex items-center gap-3 rounded-lg border border-white/10 bg-black/20 p-3';
---

<section class="mx-auto max-w-6xl px-5 py-16">
	<SectionHeading kicker={kicker} title={title} description={description} />
	<div class="grid gap-4 md:grid-cols-3">
		{cards.map((card) => (
			<div class="rounded-lg border border-white/10 bg-white/[0.03] p-6">
				<p class="text-sm font-medium uppercase tracking-[0.24em] text-zinc-500">{card.label}</p>
				<h3 class="mt-3 text-xl font-semibold text-white">{card.title}</h3>
				<ul class="mt-5 space-y-3">
					{card.items.map((item) => {
						// A cover that is configured but not uploaded yet falls back to the card's icon.
						const cover = item.cover && publicFileExists(item.cover) ? item.cover : undefined;
						const Row = item.href ? 'a' : 'div';
						return (
							<li>
								<Row
									href={item.href}
									target={item.href ? '_blank' : undefined}
									rel={item.href ? 'noreferrer' : undefined}
									class:list={[rowClass, item.href && 'transition hover:border-white/30 hover:bg-white/[0.06]']}
								>
									{cover ? (
										<img src={cover} alt="" class="h-11 w-11 shrink-0 rounded-md bg-zinc-900 object-cover" loading="lazy" decoding="async" />
									) : (
										<span class="grid h-11 w-11 shrink-0 place-items-center rounded-md bg-white/10 text-sm font-semibold text-zinc-300">{card.icon}</span>
									)}
									<span class="min-w-0 flex-1">
										<span class="block truncate text-sm font-medium text-white">{item.title}</span>
										{item.subtitle && <span class="mt-0.5 block truncate text-xs text-zinc-500">{item.subtitle}</span>}
									</span>
									{item.badge && (
										<span class="shrink-0 rounded-full border border-blue-400/25 bg-blue-400/10 px-3 py-1 text-xs font-medium text-blue-200">{item.badge}</span>
									)}
								</Row>
							</li>
						);
					})}
				</ul>
				{card.note && <p class="mt-4 text-xs leading-5 text-zinc-500">{card.note}</p>}
			</div>
		))}
	</div>
</section>
