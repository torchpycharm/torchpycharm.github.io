---
import { getCollection } from 'astro:content';
import BlogList from '../components/BlogList.astro';
import SectionHeading from '../components/SectionHeading.astro';

interface Props {
	kicker?: string;
	title: string;
	description?: string;
	labels: {
		search: string;
		all: string;
		empty: string;
		noPosts: string;
	};
}

const { description, kicker, labels, title } = Astro.props;
const posts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<section class="mx-auto max-w-5xl px-5 py-20 md:py-28">
	<SectionHeading kicker={kicker} title={title} description={description} />
	{posts.length > 0 ? (
		<BlogList posts={posts} labels={labels} />
	) : (
		<p class="rounded-lg border border-white/10 bg-white/[0.03] p-6 text-sm text-zinc-400">{labels.noPosts}</p>
	)}
</section>
